{
  "name": "vietwards",
  "version": "1.0.2",
  "private": true,
  "description": "VietWards — Bản đồ và danh mục địa giới hành chính Việt Nam",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:structure": "node scripts/check.mjs",
    "check:data": "node scripts/verify-data.mjs",
    "check:province": "node --experimental-strip-types scripts/verify-province-explorer.mjs",
    "check:gis:online": "node scripts/verify-live-gis.mjs",
    "check:history": "node --experimental-strip-types scripts/verify-historical-selection.mjs",
    "check:communes": "node --experimental-strip-types scripts/verify-commune-explorer.mjs",
    "check:legacy": "node --experimental-strip-types scripts/verify-legacy-atlas.mjs",
    "check:verified": "node scripts/verify-verified-stats.mjs",
    "check:education": "node --experimental-strip-types scripts/verify-education.mjs",
    "check:qa": "node scripts/verify-quality-gates.mjs",
    "test:e2e": "playwright test",
    "check:release": "node scripts/verify-public-release.mjs",
    "check:uiux": "node scripts/verify-mobile-map-ux.mjs",
    "check:challenge": "node --experimental-strip-types scripts/verify-challenge-v102.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.77.0",
    "maplibre-gl": "^5.4.0",
    "vn-local-divisions": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.0"
  }
}
